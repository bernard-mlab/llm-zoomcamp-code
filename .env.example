# LLM (OpenAI-compatible) — opencode-go proxy, model id Hy3
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode-go.example/v1
OPENCODE_GO_MODEL=Hy3
# Optional secondary model for LLM eval comparison (leave blank to skip)
SECONDARY_MODEL=

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=arxiv_papers

# Embedding / reranker (fastembed)
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# arXiv ingest
ARXIV_MAX_RESULTS=3000
ARXIV_CATEGORIES=cs.AI,cs.CL,cs.LG

# Langfuse (self-hosted)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Create your own keys: sign up at http://localhost:3000 first, then Settings -> API Keys

# Langfuse self-host crypto material (consumed by docker-compose.yml, not the
# app). Generate fresh values for a new stack:
#   for k in NEXTAUTH_SECRET ENCRYPTION_KEY SALT; do echo "$k=$(openssl rand -hex 32)"; done
# Do not change these on an existing stack - it invalidates the API keys above.
NEXTAUTH_SECRET=
ENCRYPTION_KEY=
SALT=